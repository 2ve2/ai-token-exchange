{
  "name": "@ai-token-exchange/api",
  "type": "module",
  "module": "src/server.ts",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts",
    "test:ai-failure": "OLLAMA_BASE_URL=http://127.0.0.1:9 bun test --preload ./tests/setup.ts tests/ai-failure.test.ts",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write --unsafe ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
